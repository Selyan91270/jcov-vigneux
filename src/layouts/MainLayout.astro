---
// Layout principal de l'application
// Contient la structure de base de toutes les pages

// Importation des composants
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getImage } from 'astro:assets';
import { images } from '../data/images.ts';

// Importation des styles globaux (Tailwind)
import '../styles/global.css';

// Props du layout
interface Props {
  title?: string;
  /** Description propre à la page — sert au référencement et à l'aperçu des liens partagés. */
  description?: string;
}

const {
  title = 'JCOV - Judo Club Olympique de Vigneux',
  description = 'Club de judo à Vigneux-sur-Seine. Cours enfants et adultes dès 4 ans, encadrés par des professeurs diplômés d\'État. Deux cours d\'essai gratuits.',
} = Astro.props;

const appleTouchIcon = await getImage({ src: images.logo, width: 180, height: 180, format: 'png' });

// Image d'aperçu pour les partages (Facebook, WhatsApp...) — URL absolue obligatoire.
const shareImage = await getImage({ src: images.heroJudo, width: 1200, height: 630, format: 'jpg' });
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const shareImageUrl = new URL(shareImage.src, Astro.site);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Aperçu des liens partagés (Facebook, WhatsApp, Messenger...) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="JCOV - Judo Club Olympique de Vigneux" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={shareImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Deux judokas se saluant sur le tatami du JCOV" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href={appleTouchIcon.src} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800&family=Oswald:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>

  <body class="bg-white text-gray-900 antialiased">
    <!-- Progression de lecture, aux couleurs de la ceinture blanche à noire -->
    <div class="read-progress" aria-hidden="true"><span id="read-progress-bar"></span></div>

    <!-- Navbar -->
    <Navbar />

    <!-- Contenu principal de la page -->
    <main class="min-h-screen">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />

    <script>
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!prefersReducedMotion) {
        document.documentElement.classList.add('js-reveal');

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15, rootMargin: '0px 0px -80px 0px' }
        );

        document.querySelectorAll('.fade-in-up').forEach((el) => observer.observe(el));

        // Cascade automatique : les cartes d'une même grille se révèlent l'une
        // après l'autre, sans avoir à numéroter les délais dans chaque page.
        document
          .querySelectorAll('.actualites-grid, .coaches-grid, .events-list, .code-moral-grid')
          .forEach((grid) => {
            [...grid.children].forEach((child, i) => {
              child.classList.add('fade-in-up');
              (child as HTMLElement).style.setProperty('--reveal-delay', `${i * 0.09}s`);
              observer.observe(child);
            });
          });
      }

      // Progression de lecture + parallax du hero, regroupés dans une seule
      // boucle rAF pour ne pas multiplier les écouteurs de scroll.
      const progressBar = document.getElementById('read-progress-bar');
      const heroMedia = document.querySelector<HTMLElement>('.hero__media');
      let ticking = false;

      const onFrame = () => {
        const scrollY = window.scrollY;
        const scrollable = document.documentElement.scrollHeight - window.innerHeight;

        if (progressBar) {
          const ratio = scrollable > 0 ? Math.min(scrollY / scrollable, 1) : 0;
          progressBar.style.transform = `scaleX(${ratio})`;
        }

        if (heroMedia && !prefersReducedMotion && scrollY < window.innerHeight) {
          heroMedia.style.transform = `translate3d(0, ${scrollY * 0.28}px, 0)`;
        }

        ticking = false;
      };

      const requestFrame = () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(onFrame);
        }
      };

      requestFrame();
      window.addEventListener('scroll', requestFrame, { passive: true });
      window.addEventListener('resize', requestFrame, { passive: true });
    </script>
  </body>
</html>