---
// Layout principal de l'application
// Contient la structure de base de toutes les pages

// Importation des composants
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

// Importation des styles globaux (Tailwind)
import '../styles/global.css';

// Props du layout
interface Props {
  title?: string;
}

const { title = 'JCOV - Judo Club Olympique de Vigneux' } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="JCOV - Club de judo depuis 1989 à Vigneux-sur-Seine. Respect, discipline et dépassement de soi." />
    <link rel="icon" type="image/png" href="/logo-jcov.png" />
    <link rel="apple-touch-icon" href="/logo-jcov.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,400&family=Noto+Serif+JP:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>

  <body class="bg-white text-gray-900 antialiased">
    <!-- Navbar -->
    <Navbar />

    <!-- Contenu principal de la page -->
    <main class="min-h-screen">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />
  </body>
</html>