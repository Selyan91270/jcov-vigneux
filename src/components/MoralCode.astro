---
// Version complète du code moral. Elle occupe sa propre page : sur l'accueil,
// c'est `MoralCodeStrip` qui en donne le signal en quelques lignes.
import { moralCodeContent, moralValues } from '../data/moralCode.ts';

interface Props {
  /** 1 quand la section fait office de titre de page. */
  headingLevel?: 1 | 2;
}

const { headingLevel = 2 } = Astro.props;
const Heading = `h${headingLevel}` as 'h1' | 'h2';

const { label, titleBefore, titleHighlight, titleAfter, subtitle, quote } = moralCodeContent;
---

<section id="code-moral" class="code-moral-section" aria-labelledby="code-moral-title">
  <!-- Fond papier washi -->
  <div class="code-moral__washi" aria-hidden="true"></div>

  <!-- Cercle Enso -->
  <div class="code-moral__enso" aria-hidden="true">
    <svg viewBox="0 0 520 520" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path
        d="M260 48c118 0 214 96 214 214 0 92-58 170-139 200-8 3-17-3-17-12 0-6 4-11 10-13 68-24 116-88 116-175 0-96-78-174-174-174-96 0-174 78-174 174 0 42 15 81 40 111 5 6 4 15-2 20-6 5-15 4-20-2-30-35-48-80-48-129 0-118 96-214 214-214Z"
        stroke="currentColor"
        stroke-width="3.5"
        stroke-linecap="round"
        opacity="0.55"
      />
      <path
        d="M78 268c12-88 82-152 172-152 28 0 54 7 77 19"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        opacity="0.25"
      />
    </svg>
  </div>

  <!-- Bambou décoratif (gauche) -->
  <div class="code-moral__bamboo" aria-hidden="true">
    <svg viewBox="0 0 120 420" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M28 420V80" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" opacity="0.35" />
      <path d="M28 180h14M28 260h14M28 340h14" stroke="currentColor" stroke-width="1.2" opacity="0.3" />
      <path d="M52 420V40" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" opacity="0.45" />
      <path d="M52 120h16M52 210h16M52 300h16" stroke="currentColor" stroke-width="1.2" opacity="0.35" />
      <path d="M78 420V120" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.3" />
      <path d="M78 220h12" stroke="currentColor" stroke-width="1.2" opacity="0.25" />
      <path d="M8 60c18-28 36-18 48 4s28 10 36-8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" opacity="0.28" />
      <path d="M34 28c16-22 30-12 40 6s22 8 30-6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" opacity="0.22" />
      <path d="M60 18c14-18 26-10 34 8s20 6 26-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" opacity="0.2" />
      <ellipse cx="18" cy="72" rx="10" ry="4" stroke="currentColor" stroke-width="1" opacity="0.18" transform="rotate(-25 18 72)" />
      <ellipse cx="44" cy="42" rx="11" ry="4" stroke="currentColor" stroke-width="1" opacity="0.16" transform="rotate(-18 44 42)" />
      <ellipse cx="70" cy="32" rx="9" ry="3.5" stroke="currentColor" stroke-width="1" opacity="0.14" transform="rotate(-12 70 32)" />
    </svg>
  </div>

  <!-- Montagne (bas gauche) -->
  <div class="code-moral__mountain" aria-hidden="true">
    <svg viewBox="0 0 240 120" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0 120L80 36L140 88L200 20L240 120H0Z" fill="currentColor" opacity="0.06" />
      <path d="M80 36L140 88" stroke="currentColor" stroke-width="1" opacity="0.12" />
      <path d="M200 20L140 88" stroke="currentColor" stroke-width="1" opacity="0.1" />
    </svg>
  </div>

  <!-- Motif seigaiha (haut droit) -->
  <div class="code-moral__seigaiha" aria-hidden="true">
    <svg viewBox="0 0 160 160" fill="none" xmlns="http://www.w3.org/2000/svg">
      <g opacity="0.35">
        <path d="M0 80a40 40 0 0 1 80 0" stroke="currentColor" stroke-width="1" />
        <path d="M40 80a40 40 0 0 1 80 0" stroke="currentColor" stroke-width="1" />
        <path d="M80 80a40 40 0 0 1 80 0" stroke="currentColor" stroke-width="1" />
        <path d="M0 120a40 40 0 0 1 80 0" stroke="currentColor" stroke-width="1" />
        <path d="M40 120a40 40 0 0 1 80 0" stroke="currentColor" stroke-width="1" />
        <path d="M80 120a40 40 0 0 1 80 0" stroke="currentColor" stroke-width="1" />
        <path d="M0 40a40 40 0 0 1 80 0" stroke="currentColor" stroke-width="1" />
        <path d="M40 40a40 40 0 0 1 80 0" stroke="currentColor" stroke-width="1" />
        <path d="M80 40a40 40 0 0 1 80 0" stroke="currentColor" stroke-width="1" />
      </g>
    </svg>
  </div>

  <!-- Kanji 柔道 (droite) -->
  <p class="code-moral__kanji" aria-hidden="true">柔道</p>

  <div class="code-moral__inner max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <header class="code-moral__header">
      <p class="code-moral__label">{label}</p>

      <Heading id="code-moral-title" class="code-moral__title section-title">
        {titleBefore}<span class="code-moral__title-accent">{titleHighlight}</span>{titleAfter}
      </Heading>

      <p class="code-moral__subtitle">{subtitle}</p>

      <div class="code-moral__divider" aria-hidden="true">
        <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="16" cy="16" r="3" fill="currentColor" opacity="0.5" />
          <path d="M16 4v6M16 22v6M4 16h6M22 16h6" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" opacity="0.35" />
          <path d="M8.5 8.5l4 4M19.5 19.5l4 4M23.5 8.5l-4 4M12.5 19.5l-4 4" stroke="currentColor" stroke-width="1" stroke-linecap="round" opacity="0.25" />
        </svg>
      </div>

      <blockquote class="code-moral__quote">
        <p>&ldquo;{quote}&rdquo;</p>
      </blockquote>
    </header>

    <div class="code-moral-grid">
      {
        moralValues.map((value, index) => (
          <article
            class={`moral-card fade-in-up fade-in-up--delay-${(index % 4) + 1}`}
          >
            <div class="moral-card__brush" aria-hidden="true">
              <svg viewBox="0 0 300 10" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                <path
                  d="M0 6C20 2 45 8 70 5C95 2 120 7 145 4C170 1 195 6 220 4C245 2 270 7 300 5"
                  stroke="currentColor"
                  stroke-width="5"
                  stroke-linecap="round"
                  fill="none"
                />
                <path
                  d="M12 7C35 4 58 8 82 6C106 4 130 7 154 5C178 3 202 7 226 5C250 3 274 7 288 6"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  fill="none"
                  opacity="0.45"
                />
              </svg>
            </div>

            <span class="moral-card__kanji" aria-hidden="true">{value.kanji}</span>

            <div class="moral-card__icon" aria-hidden="true">
              {value.icon === 'bow' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="8" cy="6" r="2.2" />
                  <circle cx="16" cy="6" r="2.2" />
                  <path d="M6 10v8l2 2M18 10v8l-2 2" />
                  <path d="M8 12h8M10 16h4" />
                </svg>
              )}
              {value.icon === 'mountain' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 20L12 6l8 14H4Z" />
                  <circle cx="18" cy="6" r="2.5" />
                  <path d="M16 6h4" />
                </svg>
              )}
              {value.icon === 'enso' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
                  <path d="M12 4c4.4 0 8 3.6 8 8s-3.6 8-8 8" />
                  <path d="M8 12c0-2.2 1.8-4 4-4" opacity="0.5" />
                </svg>
              )}
              {value.icon === 'torii' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 8h16M6 8v12M18 8v12" />
                  <path d="M8 14h8M10 8V5M14 8V5" />
                </svg>
              )}
              {value.icon === 'bamboo' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
                  <path d="M8 22V6M16 22V2" />
                  <path d="M6 12h4M14 10h4M14 16h4" />
                  <path d="M4 8c3-2 5 0 6 2M14 6c3-2 5 0 6 2" />
                </svg>
              )}
              {value.icon === 'hands' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M8 10V6a2 2 0 0 1 4 0v4" />
                  <path d="M12 10V5a2 2 0 0 1 4 0v6" />
                  <path d="M8 10c0 4 2 8 4 10 2-2 4-6 4-10" />
                  <path d="M12 16v4M10 20h4" />
                </svg>
              )}
              {value.icon === 'meditation' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="5.5" r="2.2" />
                  <path d="M8 20v-5l4-3 4 3v5" />
                  <path d="M6 20h12" />
                  <path d="M10 12l2-2 2 2" />
                </svg>
              )}
              {value.icon === 'handshake' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 12l4-2 3 2 2-3 3 2 4-1" />
                  <path d="M8 10V7M12 9V6M16 8V5" />
                  <path d="M6 14l3 2 3-1 2 2 4 1" />
                </svg>
              )}
            </div>

            <h3 class="moral-card__title">{value.title}</h3>
            <p class="moral-card__japanese">{value.japanese}</p>
            <p class="moral-card__description">{value.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .code-moral-section {
    position: relative;
    overflow: hidden;
    background-color: var(--surface-washi);
    padding-top: 6.5rem;
    padding-bottom: 5.5rem;
  }

  .code-moral__washi {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 12% 12%, rgba(11, 114, 173, 0.08), transparent 18%),
      radial-gradient(circle at 88% 16%, rgba(11, 114, 173, 0.06), transparent 20%),
      repeating-linear-gradient(90deg, rgba(255,255,255,0.95), rgba(255,255,255,0.95) 1px, transparent 1px, transparent 24px),
      linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(250, 250, 247, 0.99));
    pointer-events: none;
  }

  .code-moral__enso {
    position: absolute;
    top: 2.5rem;
    right: 2rem;
    width: clamp(14rem, 22vw, 22rem);
    height: clamp(14rem, 22vw, 22rem);
    color: var(--brand-700);
    pointer-events: none;
  }

  .code-moral__bamboo {
    position: absolute;
    left: 1rem;
    bottom: -2rem;
    width: clamp(4rem, 8vw, 6rem);
    height: clamp(16rem, 30vw, 24rem);
    color: var(--brand-700);
    pointer-events: none;
    display: none;
  }

  .code-moral__mountain {
    position: absolute;
    left: 0;
    bottom: 0;
    width: clamp(12rem, 22vw, 18rem);
    color: var(--brand-900);
    pointer-events: none;
  }

  .code-moral__seigaiha {
    position: absolute;
    top: -2rem;
    right: -2rem;
    width: clamp(8rem, 14vw, 11rem);
    color: var(--brand-700);
    pointer-events: none;
    display: none;
  }

  .code-moral__kanji {
    position: absolute;
    top: 1rem;
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    font-size: clamp(8rem, 14vw, 15rem);
    line-height: 0.95;
    font-weight: 700;
    color: rgba(11, 114, 173, 0.05);
    z-index: 0;
    white-space: nowrap;
    pointer-events: none;
  }

  @media (min-width: 768px) {
    .code-moral__bamboo,
    .code-moral__seigaiha {
      display: block;
    }
  }

  .code-moral__inner {
    position: relative;
    z-index: 1;
  }

  .code-moral__header {
    position: relative;
    max-width: 42rem;
    margin: 0 auto 3.5rem;
    text-align: center;
  }

  .code-moral__label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1rem;
    color: var(--brand-700);
    font-family: var(--ff-head);
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .code-moral__label::before {
    content: '';
    width: 1.5rem;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--brand-700), var(--brand-accent));
  }

  /* La taille vient de `.section-title`, partagée avec les autres rubriques
     de l'accueil. Ce titre garde sa graisse plus appuyée. */
  .code-moral__title {
    margin: 0 0 1rem;
    font-family: var(--ff-head);
    font-weight: 800;
    color: #0f172a;
  }

  .code-moral__title-accent {
    background: linear-gradient(90deg, var(--brand-700), var(--brand-accent));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .code-moral__subtitle {
    margin: 0 0 1.5rem;
    color: #64748b;
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .code-moral__divider {
    width: 2rem;
    height: 2rem;
    margin: 0 auto 1.5rem;
    color: var(--brand-700);
  }

  .code-moral__quote {
    margin: 0 auto;
    max-width: 34rem;
    color: #334155;
    font-style: italic;
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .code-moral-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 1.75rem;
  }

  @media (min-width: 640px) {
    .code-moral-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .code-moral-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .moral-card {
    position: relative;
    z-index: 1;
    background-color: #ffffff;
    border-radius: 1.25rem;
    border-top: 4px solid transparent;
    border-image: linear-gradient(90deg, var(--brand-700), var(--brand-accent)) 1;
    box-shadow: var(--shadow-md);
    padding: 2rem 1.75rem;
    transition: transform 0.35s ease, box-shadow 0.35s ease;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    text-align: center;
    align-items: center;
  }

  .moral-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 30px 80px rgba(3, 29, 56, 0.14);
  }

  .moral-card__brush {
    display: none;
  }

  .moral-card__kanji {
    font-size: 2rem;
    line-height: 1;
    color: rgba(11, 114, 173, 0.16);
    font-weight: 700;
  }

  .moral-card__icon {
    inline-size: 3.75rem;
    block-size: 3.75rem;
    margin-top: -1.75rem;
    border-radius: 1.25rem;
    background: linear-gradient(135deg, rgba(11, 114, 173, 0.1), rgba(25, 169, 245, 0.14));
    color: var(--brand-700);
    display: grid;
    place-items: center;
    transition: transform 0.35s ease, background-color 0.35s ease;
  }

  .moral-card:hover .moral-card__icon {
    transform: translateY(-3px) scale(1.08);
  }

  .moral-card__icon svg {
    width: 1.9rem;
    height: 1.9rem;
  }

  .moral-card__title {
    margin: 0;
    color: var(--text-default);
    font-family: var(--ff-head);
    font-size: 1.15rem;
    font-weight: 800;
  }

  .moral-card__japanese {
    margin: -0.5rem 0 0;
    color: var(--brand-700);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .moral-card__description {
    margin: 0;
    color: #64748b;
    font-size: 0.92rem;
    line-height: 1.7;
  }

  @media (max-width: 640px) {
    .code-moral-section {
      padding-top: 4rem;
      padding-bottom: 4rem;
    }

    .code-moral__kanji {
      font-size: 6rem;
    }

    .code-moral__enso {
      width: 12rem;
      height: 12rem;
      top: 1rem;
      right: -2rem;
    }
  }
</style>
