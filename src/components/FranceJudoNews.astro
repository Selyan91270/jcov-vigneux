---
import { getFranceJudoNews, type NewsItem } from '../services/ffjudoNews.ts';
const news: NewsItem[] = await getFranceJudoNews(2);
---

<section id="actualites" class="actualites-section py-20 border-b border-gray-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between mb-12">
      <div>
        <span class="text-jcov font-semibold text-sm uppercase tracking-[0.2em] mb-3 block">Actualités</span>
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 tracking-tight">Actualités France Judo</h2>
        <p class="mt-4 text-gray-600 max-w-2xl leading-relaxed">
          Retrouvez les dernières actualités du judo français publiées sur le site officiel de la Fédération.
        </p>
      </div>

      <a
        href="https://www.ffjudo.com/actualites"
        target="_blank"
        rel="noreferrer noopener"
        class="inline-flex items-center justify-center rounded-full border border-jcov px-6 py-3 text-sm font-semibold text-jcov transition hover:bg-jcov hover:text-white"
      >
        Voir toutes les actualités
      </a>
    </div>

    <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-4">
      {news.length > 0 ? (
        news.map((item) => (
          <article class="group flex flex-col overflow-hidden rounded-3xl border border-gray-200 bg-white shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl">
            <div class="actualites-card__image relative overflow-hidden bg-slate-100">
              {item.image ? (
                <img
                  src={item.image}
                  alt={item.title}
                  loading="lazy"
                  class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                />
              ) : (
                <div class="flex h-full items-center justify-center bg-gray-200 text-gray-500">Image non disponible</div>
              )}
              {item.category ? (
                <span class="absolute left-4 top-4 inline-flex rounded-full bg-jcov px-3 py-1 text-xs font-semibold uppercase tracking-[0.2em] text-white shadow-sm">
                  {item.category}
                </span>
              ) : null}
            </div>

            <div class="flex flex-1 flex-col gap-4 p-6">
              <div>
                {item.date ? <p class="text-xs uppercase tracking-[0.24em] text-jcov mb-2">{item.date}</p> : null}
                <h3 class="text-xl font-semibold text-gray-900 leading-tight">{item.title}</h3>
                <p class="mt-4 text-gray-600 text-sm leading-relaxed">{item.summary || 'Résumé non disponible.'}</p>
              </div>

              <div class="mt-auto pt-4">
                <a
                  href={item.link}
                  target="_blank"
                  rel="noreferrer noopener"
                  class="inline-flex w-full items-center justify-center rounded-full bg-jcov px-5 py-3 text-sm font-semibold text-white transition hover:bg-jcov-dark"
                >
                  Lire l'article
                </a>
              </div>
            </div>
          </article>
        ))
      ) : (
        <div class="col-span-full rounded-3xl border border-gray-200 bg-white p-10 text-center shadow-sm">
          <p class="text-gray-700 text-lg font-semibold">Les actualités sont temporairement indisponibles.</p>
          <p class="mt-3 text-gray-500">Veuillez réessayer plus tard ou consulter directement le site de France Judo.</p>
          <a
            href="https://www.ffjudo.com/actualites"
            target="_blank"
            rel="noreferrer noopener"
            class="mt-6 inline-flex items-center justify-center rounded-full bg-jcov px-6 py-3 text-sm font-semibold text-white transition hover:bg-jcov-dark"
          >
            Ouvrir France Judo
          </a>
        </div>
      )}
    </div>
  </div>
</section>
