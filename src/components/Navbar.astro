---
import { Image } from 'astro:assets';
import { navLinks } from '../data/club.ts';
import { images } from '../data/images.ts';

const linkClass = 'navbar__link text-sm uppercase';
---

<nav class="navbar sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">

      <a href="/" class="flex items-center hover:opacity-90 transition-opacity">
        <Image src={images.logo} alt="Logo du Judo Club Olympique de Vigneux" class="h-12 md:h-14 w-auto" width={168} height={112} />
      </a>

      <div class="hidden lg:flex items-center space-x-6 xl:space-x-8">
        {navLinks.map((link) => (
          <a href={link.href} class={linkClass}>
            {link.label}
          </a>
        ))}
        <a href="https://aspttnancy.monclub.app/login" target="_blank" rel="noopener noreferrer" class="navbar__cta">
          Rejoindre
        </a>
      </div>

      <button
        type="button"
        id="mobile-menu-button"
        class="navbar__burger-btn lg:hidden text-gray-900 hover:text-jcov transition-colors"
        aria-label="Ouvrir le menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="navbar__burger" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </button>
    </div>

    <div class="lg:hidden navbar__mobile" id="mobile-menu">
      <div class="navbar__mobile-inner">
        <div class="flex flex-col space-y-2 pb-4">
          {navLinks.map((link, i) => (
            <a href={link.href} class={`${linkClass} navbar__mobile-link py-2`} style={`--i:${i}`}>
              {link.label}
            </a>
          ))}
          <a
            href="https://aspttnancy.monclub.app/login"
            target="_blank"
            rel="noopener noreferrer"
            class="navbar__cta navbar__cta--mobile navbar__mobile-link"
            style={`--i:${navLinks.length}`}
          >
            Rejoindre le club
          </a>
        </div>
      </div>
    </div>
  </div>
  <div class="belt-stripe" aria-hidden="true"></div>
</nav>

<script>
  const button = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');

  const setMenu = (isOpen: boolean) => {
    menu?.classList.toggle('is-open', isOpen);
    button?.classList.toggle('is-active', isOpen);
    button?.setAttribute('aria-expanded', String(isOpen));
    button?.setAttribute('aria-label', isOpen ? 'Fermer le menu' : 'Ouvrir le menu');
  };

  button?.addEventListener('click', () => {
    setMenu(!menu?.classList.contains('is-open'));
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setMenu(false));
  });

  // Fermeture au clavier, réflexe attendu sur un menu déroulant.
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu?.classList.contains('is-open')) {
      setMenu(false);
      button?.focus();
    }
  });

  const navbar = document.querySelector('.navbar');
  const onScroll = () => navbar?.classList.toggle('navbar--scrolled', window.scrollY > 12);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .navbar {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition: box-shadow 0.3s ease, background-color 0.3s ease;
  }

  .navbar--scrolled {
    background: rgba(255, 255, 255, 0.96);
    box-shadow: 0 8px 30px rgba(3, 29, 56, 0.08);
  }

  .navbar__link {
    position: relative;
    color: #0f172a;
    font-family: var(--ff-head);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.25;
    text-decoration: none;
    transition: color 250ms ease, transform 250ms ease;
  }

  .navbar__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 100%;
    bottom: -6px;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--brand-700), var(--brand-accent));
    transition: right 250ms ease;
  }

  .navbar__link:hover,
  .navbar__link:focus-visible {
    color: var(--brand-700);
  }

  .navbar__link:hover::after,
  .navbar__link:focus-visible::after {
    right: 0;
  }

  @media (hover: hover) and (pointer: fine) {
    .navbar__link:hover {
      transform: translateY(-1px);
    }
  }

  .navbar__cta {
    display: inline-flex;
    align-items: center;
    color: #fff;
    background: linear-gradient(90deg, var(--brand-700), var(--brand-accent));
    font-family: var(--ff-head);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.55rem 1.15rem;
    border-radius: 9999px;
    box-shadow: 0 8px 20px rgba(11, 114, 173, 0.28);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .navbar__cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 26px rgba(11, 114, 173, 0.35);
  }

  .navbar__cta--mobile {
    justify-content: center;
    margin-top: 0.5rem;
  }

  /* ── Menu mobile animé ── */
  .navbar__mobile {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 340ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .navbar__mobile.is-open {
    grid-template-rows: 1fr;
  }

  .navbar__mobile-inner {
    overflow: hidden;
    visibility: hidden;
    transition: visibility 340ms;
  }

  .navbar__mobile.is-open .navbar__mobile-inner {
    visibility: visible;
  }

  /* Les entrées arrivent en cascade une fois le panneau ouvert. */
  .navbar__mobile-link {
    opacity: 0;
    transform: translateY(-6px);
    transition: opacity 260ms ease, transform 260ms ease;
  }

  /* Hauteur de doigt sur chaque entrée du menu. */
  .navbar__mobile .navbar__mobile-link {
    display: flex;
    align-items: center;
    min-height: 44px;
  }

  .navbar__mobile .navbar__cta--mobile {
    justify-content: center;
    min-height: 48px;
  }

  .navbar__mobile.is-open .navbar__mobile-link {
    opacity: 1;
    transform: translateY(0);
    transition-delay: calc(90ms + var(--i) * 45ms);
  }

  /* Zone tactile de 44 px minimum autour de l'icône, qui n'en fait que 24 :
     en dessous, le bouton devient difficile à viser au pouce. La marge
     négative évite que cet agrandissement décale la mise en page. */
  .navbar__burger-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    -webkit-tap-highlight-color: transparent;
  }

  /* ── Bouton hamburger qui se transforme en croix ── */
  .navbar__burger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 1.5rem;
    height: 1.5rem;
  }

  .navbar__burger span {
    display: block;
    height: 2px;
    width: 100%;
    border-radius: 2px;
    background: currentColor;
    transition: transform 300ms cubic-bezier(0.4, 0, 0.2, 1), opacity 200ms ease;
  }

  .is-active .navbar__burger span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .is-active .navbar__burger span:nth-child(2) {
    opacity: 0;
  }

  .is-active .navbar__burger span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .navbar__mobile,
    .navbar__mobile-inner,
    .navbar__mobile-link,
    .navbar__burger span {
      transition: none;
    }
  }
</style>
