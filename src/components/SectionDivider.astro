---
// Transition diagonale entre deux sections, à la place d'un simple trait.
// `from` = couleur de la section au-dessus, `to` = couleur de la section en dessous.
interface Props {
  from: string;
  to: string;
  /** Inverse le sens de la pente, pour éviter un motif répétitif. */
  flip?: boolean;
}

const { from, to, flip = false } = Astro.props;
---

<div class="section-divider" style={`background:${from}`} aria-hidden="true">
  <svg viewBox="0 0 1440 48" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
    <path d={flip ? 'M0 0 L1440 48 L1440 48 L0 48 Z' : 'M0 48 L1440 0 L1440 48 Z'} fill={to} />
  </svg>
</div>

<style>
  .section-divider {
    line-height: 0;
  }

  .section-divider svg {
    display: block;
    width: 100%;
    height: 2.5rem;
  }

  @media (min-width: 768px) {
    .section-divider svg {
      height: 3rem;
    }
  }
</style>
