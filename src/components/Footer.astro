---
// Footer simple avec informations de contact
// Pied de page minimaliste et élégant
import { Image } from 'astro:assets';
import { images } from '../data/images.ts';
import { club } from '../data/club.ts';
import { partners } from '../data/partners.ts';
---

<footer class="jcov-footer">
  <div class="belt-stripe" aria-hidden="true"></div>
  <div class="grain-overlay" aria-hidden="true"></div>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

      <div class="flex flex-col items-start">
        <Image src={images.logo} alt="Logo du Judo Club Olympique de Vigneux" class="h-24 w-auto mb-3" width={288} height={192} />
        <h3 class="jcov-footer__title">
          Judo Club Olympique de Vigneux
        </h3>
        <p class="jcov-footer__subtitle">
          Club de judo depuis {club.foundedYear}
        </p>
      </div>

      <div>
        <h4 class="jcov-footer__heading">
          Contact
        </h4>
        <ul class="jcov-footer__list">
          <li class="flex items-center">
            <svg class="jcov-footer__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            {club.address.venue}<br>{club.address.street}<br>{club.address.city}
          </li>
          <li class="flex items-center">
            <svg class="jcov-footer__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
            <a href={`tel:${club.phone.replace(/\s/g, '')}`} class="jcov-footer__link">{club.phone}</a>
          </li>
          <li class="flex items-center">
            <svg class="jcov-footer__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
            <a href={`mailto:${club.email}`} class="jcov-footer__link">{club.email}</a>
          </li>
        </ul>

        <a
          href={club.facebook}
          target="_blank"
          rel="noopener noreferrer"
          class="jcov-footer__social"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.51 1.5-3.89 3.77-3.89 1.09 0 2.24.19 2.24.19v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.45 2.89h-2.33v6.99A10 10 0 0 0 22 12Z" />
          </svg>
          Suivez-nous sur Facebook
        </a>
      </div>
    </div>

    <div class="jcov-footer__partners">
      <p class="jcov-footer__partners-label">Partenaires &amp; affiliation</p>
      <ul class="jcov-footer__partners-list">
        {partners.map((partner) => (
          <li>
            <a href={partner.url} target="_blank" rel="noopener noreferrer" aria-label={partner.name}>
              {partner.logo ? (
                <span class={`jcov-footer__partner-slot jcov-footer__partner-slot--${partner.logoBackdrop ?? 'light'}`}>
                  <Image src={partner.logo} alt={partner.name} height={44} class="jcov-footer__partner-logo" />
                </span>
              ) : (
                <span class="jcov-footer__partner-name">{partner.name}</span>
              )}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="jcov-footer__bottom">
      <p>
        &copy; {new Date().getFullYear()} JCOV - Judo Club Olympique de Vigneux. Tous droits réservés.
      </p>
      <nav class="jcov-footer__legal" aria-label="Informations légales">
        <a href="/mentions-legales">Mentions légales</a>
        <span aria-hidden="true">·</span>
        <a href="/confidentialite">Confidentialité</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .jcov-footer {
    position: relative;
    overflow: hidden;
    background: linear-gradient(90deg, #031d38 0%, #082d4d 28%, #0a3d61 52%, #0d5c8f 100%);
    color: #ffffff;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .jcov-footer::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(255,255,255,0.04), rgba(255,255,255,0));
    pointer-events: none;
  }

  .jcov-footer::after {
    content: "柔道";
    position: absolute;
    right: 2.5rem;
    top: 50%;
    transform: translateY(-50%) rotate(20deg);
    font-size: clamp(7rem, 9vw, 13rem);
    line-height: 1;
    font-weight: 700;
    color: rgba(25, 169, 245, 0.12);
    letter-spacing: 0.02em;
    pointer-events: none;
    user-select: none;
    white-space: nowrap;
  }

  .jcov-footer > * {
    position: relative;
    z-index: 1;
  }

  .jcov-footer__title {
    margin-bottom: 0.5rem;
    color: #ffffff;
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .jcov-footer__subtitle,
  .jcov-footer__list,
  .jcov-footer__bottom p {
    color: rgba(236, 246, 255, 0.92);
  }

  .jcov-footer__subtitle {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .jcov-footer__heading {
    margin-bottom: 1rem;
    color: #eaf9ff;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .jcov-footer__list {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.88rem;
    line-height: 1.9;
    display: grid;
    gap: 0.45rem;
  }

  .jcov-footer__icon {
    width: 0.9rem;
    height: 0.9rem;
    margin-right: 0.6rem;
    color: #19A9F5;
    flex-shrink: 0;
    opacity: 1;
  }

  /* Téléphone et e-mail sont les liens les plus utiles depuis un mobile :
     on leur donne une zone tactile confortable plutôt que la seule hauteur
     du texte. */
  .jcov-footer__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .jcov-footer__link:hover {
    color: var(--brand-accent);
    text-decoration: underline;
  }

  .jcov-footer__social {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 1.5rem;
    min-height: 44px;
    padding: 0.6rem 1.1rem;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 9999px;
    color: #ffffff;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-decoration: none;
    transition: background-color 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
  }

  .jcov-footer__social svg {
    width: 1.15rem;
    height: 1.15rem;
    color: var(--brand-accent);
    flex-shrink: 0;
  }

  .jcov-footer__social:hover {
    background-color: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.45);
    transform: translateY(-2px);
  }

  /* ── Partenaires ── */
  .jcov-footer__partners {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    text-align: center;
  }

  .jcov-footer__partners-label {
    margin: 0 0 1.25rem;
    color: rgba(236, 246, 255, 0.6);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .jcov-footer__partners-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.5rem 2.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .jcov-footer__partners-list a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .jcov-footer__partners-list a:hover {
    transform: translateY(-2px);
  }

  /* Même gabarit pour tous les partenaires, quel que soit le logo : c'est ce
     qui garde la rangée régulière malgré des proportions différentes. */
  .jcov-footer__partner-slot {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 3.75rem;
    min-width: 8.5rem;
    padding: 0.5rem 1rem;
    border-radius: 0.6rem;
    transition: background-color 0.25s ease;
  }

  /* Logo coloré ou sombre : pastille blanche, sinon illisible sur le bleu. */
  .jcov-footer__partner-slot--light {
    background: #ffffff;
  }

  /* Logo blanc : conçu pour un fond sombre, il reste sur le bleu du footer. */
  .jcov-footer__partner-slot--dark {
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.14);
  }

  .jcov-footer__partners-list a:hover .jcov-footer__partner-slot--dark {
    background: rgba(255, 255, 255, 0.14);
  }

  .jcov-footer__partner-logo {
    height: 2.75rem;
    width: auto;
    object-fit: contain;
  }

  /* Repli tant qu'aucun fichier de logo n'est fourni. */
  .jcov-footer__partner-name {
    display: inline-flex;
    align-items: center;
    min-height: 3.5rem;
    padding: 0.5rem 1.1rem;
    border: 1px dashed rgba(255, 255, 255, 0.28);
    border-radius: 0.6rem;
    color: rgba(236, 246, 255, 0.82);
    font-size: 0.82rem;
    font-weight: 600;
    text-align: center;
  }

  .jcov-footer__partners-list a:hover .jcov-footer__partner-name {
    border-color: rgba(255, 255, 255, 0.55);
    color: #ffffff;
  }

  .jcov-footer__bottom {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
  }

  .jcov-footer__bottom p {
    margin: 0;
    text-align: center;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: rgba(239, 247, 255, 0.9);
  }

  .jcov-footer__legal {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.72rem;
    color: rgba(239, 247, 255, 0.75);
  }

  .jcov-footer__legal a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.25rem;
    color: rgba(239, 247, 255, 0.85);
    text-decoration: none;
  }

  .jcov-footer__legal a:hover {
    color: #ffffff;
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .jcov-footer__title {
      font-size: 1rem;
    }

    .jcov-footer::after {
      right: -2rem;
      font-size: 5.5rem;
    }
  }
</style>
