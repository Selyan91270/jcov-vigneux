---
// Footer simple avec informations de contact
// Pied de page minimaliste et élégant
import { Image } from 'astro:assets';
import { images } from '../data/images.ts';
---

<footer class="jcov-footer">
  <div class="belt-stripe" aria-hidden="true"></div>
  <div class="grain-overlay" aria-hidden="true"></div>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

      <div class="flex flex-col items-start">
        <Image src={images.logo} alt="Logo du Judo Club Olympique de Vigneux" class="h-24 w-auto mb-3" width={288} height={192} />
        <h3 class="jcov-footer__title">
          Judo Club Olympique de Vigneux
        </h3>
        <p class="jcov-footer__subtitle">
          Club de judo depuis 1989
        </p>
      </div>

      <div>
        <h4 class="jcov-footer__heading">
          Contact
        </h4>
        <ul class="jcov-footer__list">
          <li class="flex items-center">
            <svg class="jcov-footer__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            Dojo Marc Alexandre<br>1 bis rue du Maréchal Leclerc<br>91270 Vigneux-sur-Seine
          </li>
          <li class="flex items-center">
            <svg class="jcov-footer__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
            01 69 03 22 40
          </li>
          <li class="flex items-center">
            <svg class="jcov-footer__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
            jcov@free.fr
          </li>
        </ul>
      </div>
    </div>

    <div class="jcov-footer__bottom">
      <p>
        &copy; {new Date().getFullYear()} JCOV - Judo Club Olympique de Vigneux. Tous droits réservés.
      </p>
      <nav class="jcov-footer__legal" aria-label="Informations légales">
        <a href="/mentions-legales">Mentions légales</a>
        <span aria-hidden="true">·</span>
        <a href="/confidentialite">Confidentialité</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .jcov-footer {
    position: relative;
    overflow: hidden;
    background: linear-gradient(90deg, #031d38 0%, #082d4d 28%, #0a3d61 52%, #0d5c8f 100%);
    color: #ffffff;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .jcov-footer::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(255,255,255,0.04), rgba(255,255,255,0));
    pointer-events: none;
  }

  .jcov-footer::after {
    content: "柔道";
    position: absolute;
    right: 2.5rem;
    top: 50%;
    transform: translateY(-50%) rotate(20deg);
    font-size: clamp(7rem, 9vw, 13rem);
    line-height: 1;
    font-weight: 700;
    color: rgba(25, 169, 245, 0.12);
    letter-spacing: 0.02em;
    pointer-events: none;
    user-select: none;
    white-space: nowrap;
  }

  .jcov-footer > * {
    position: relative;
    z-index: 1;
  }

  .jcov-footer__title {
    margin-bottom: 0.5rem;
    color: #ffffff;
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .jcov-footer__subtitle,
  .jcov-footer__list,
  .jcov-footer__bottom p {
    color: rgba(236, 246, 255, 0.92);
  }

  .jcov-footer__subtitle {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .jcov-footer__heading {
    margin-bottom: 1rem;
    color: #eaf9ff;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .jcov-footer__list {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.88rem;
    line-height: 1.9;
    display: grid;
    gap: 0.45rem;
  }

  .jcov-footer__icon {
    width: 0.9rem;
    height: 0.9rem;
    margin-right: 0.6rem;
    color: #19A9F5;
    flex-shrink: 0;
    opacity: 1;
  }

  .jcov-footer__bottom {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
  }

  .jcov-footer__bottom p {
    margin: 0;
    text-align: center;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: rgba(239, 247, 255, 0.9);
  }

  .jcov-footer__legal {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.72rem;
    color: rgba(239, 247, 255, 0.75);
  }

  .jcov-footer__legal a {
    color: rgba(239, 247, 255, 0.85);
    text-decoration: none;
  }

  .jcov-footer__legal a:hover {
    color: #ffffff;
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .jcov-footer__title {
      font-size: 1rem;
    }

    .jcov-footer::after {
      right: -2rem;
      font-size: 5.5rem;
    }
  }
</style>
