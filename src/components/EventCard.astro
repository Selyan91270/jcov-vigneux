---
// Carte d'événement, partagée entre la page d'accueil et la page Événements.
// Le style vit ici : les deux emplacements restent ainsi identiques sans
// dupliquer le CSS.
import type { CollectionEntry } from 'astro:content';

interface Props {
  event: CollectionEntry<'evenements'>;
  /** Titre de niveau 2 sur la page dédiée, 3 sur l'accueil où un h2 existe déjà. */
  headingLevel?: 2 | 3;
}

const { event, headingLevel = 2 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';

const dayFormatter = new Intl.DateTimeFormat('fr-FR', { day: '2-digit' });
const monthFormatter = new Intl.DateTimeFormat('fr-FR', { month: 'short' });
const fullDateFormatter = new Intl.DateTimeFormat('fr-FR', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

{/* La date est exposée pour que le navigateur puisse reclasser la carte si
    le site a été construit avant que l'événement ne soit passé. */}
<article
  class="event-card"
  data-event-date={event.data.date.toISOString()}
  data-event-title={event.data.title}
  data-event-label={fullDateFormatter.format(event.data.date)}
>
  <div class="event-card__date">
    <span class="event-card__day">{dayFormatter.format(event.data.date)}</span>
    <span class="event-card__month">{monthFormatter.format(event.data.date).replace('.', '')}</span>
  </div>
  <div class="event-card__body">
    <span class="event-card__category">{event.data.category}</span>
    <Heading class="event-card__title">{event.data.title}</Heading>
    <p class="event-card__meta">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 21s-7-6.1-7-11a7 7 0 0 1 14 0c0 4.9-7 11-7 11Z" />
        <circle cx="12" cy="10" r="2.5" />
      </svg>
      {event.data.location}
    </p>
    <p class="event-card__meta event-card__meta--date">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="5" width="18" height="16" rx="2" />
        <path d="M8 3v4M16 3v4M3 10h18" />
      </svg>
      {fullDateFormatter.format(event.data.date)}{event.data.time ? ` · ${event.data.time}` : ''}
    </p>
    <p class="event-card__summary">{event.data.summary}</p>
  </div>
</article>

<style>
  .event-card {
    display: flex;
    gap: 1.5rem;
    background: #fff;
    border: 1px solid rgba(3, 29, 56, 0.08);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    padding: 1.75rem;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .event-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .event-card__date {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 5rem;
    height: 5rem;
    border-radius: 1rem;
    background: linear-gradient(150deg, var(--brand-900), var(--brand-700));
    color: #fff;
  }

  .event-card__day {
    font-family: var(--ff-head);
    font-size: 1.9rem;
    font-weight: 700;
    line-height: 1;
  }

  .event-card__month {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--brand-sky);
    margin-top: 0.25rem;
  }

  .event-card__body {
    min-width: 0;
    flex: 1;
  }

  .event-card__category {
    display: inline-block;
    background: var(--brand-ice);
    color: var(--brand-700);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    margin-bottom: 0.6rem;
  }

  .event-card__title {
    font-family: var(--ff-head);
    font-size: 1.4rem;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 0.65rem;
  }

  .event-card__meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #475569;
    font-size: 0.92rem;
    margin-bottom: 0.4rem;
  }

  .event-card__meta svg {
    width: 1.05rem;
    height: 1.05rem;
    color: var(--brand-accent);
    flex-shrink: 0;
  }

  .event-card__meta--date {
    text-transform: capitalize;
  }

  .event-card__summary {
    margin-top: 0.9rem;
    color: #334155;
    line-height: 1.6;
  }

  /* Sur mobile, le bloc date passe au-dessus : côte à côte, il ne laissait
     qu'une colonne de texte très étroite. */
  @media (max-width: 480px) {
    .event-card {
      flex-direction: column;
      gap: 1rem;
      padding: 1.5rem;
    }
  }
</style>
