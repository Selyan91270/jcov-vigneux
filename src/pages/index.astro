---
import { url } from '../lib/url.ts';
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';
import Hero from '../components/Hero.astro';
import Stats from '../components/Stats.astro';
import MoralCodeStrip from '../components/MoralCodeStrip.astro';
import SectionDivider from '../components/SectionDivider.astro';
import Lightbox from '../components/Lightbox.astro';
import EventCard from '../components/EventCard.astro';
import { club, clubPhotos } from '../data/club.ts';
import { images } from '../data/images.ts';

const actualites = (await getCollection('actualites')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

// Les deux prochains rendez-vous seulement : l'accueil donne un aperçu,
// la page Événements garde la liste complète.
const now = new Date();
const evenementsAVenir = (await getCollection('evenements'))
  .filter((e) => e.data.date >= now)
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

// Quatre sont rendus mais deux seulement s'affichent : si les premiers sont
// passés depuis la dernière publication, le navigateur peut prendre les
// suivants sans laisser la section vide.
const prochainsEvenements = evenementsAVenir.slice(0, 4);

const dateFormatter = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });

// Versions haute définition servies uniquement à la visionneuse plein écran.
const fullSize = new Map(
  await Promise.all(
    clubPhotos.map(async (photo) => {
      const large = await getImage({
        src: images[photo.key as keyof typeof images],
        width: 1600,
        quality: 82,
      });
      return [photo.key, large.src] as const;
    })
  )
);
---

<MainLayout title="JCOV - Judo Club Olympique de Vigneux">

  <Hero />

  <Stats />

  <section id="about" class="about-section surface relative pt-20 pb-20 sm:pt-24 md:pb-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div class="about__content fade-in-up">
          <span class="section-eyebrow mb-4">À propos</span>

          <h2 class="section-title font-bold text-gray-900 mb-6 mt-4">
            Le Judo, une école de vie
          </h2>

          <p class="text-gray-600 text-lg leading-relaxed mb-6">
            Le Judo Club Olympique de Vigneux transmet les valeurs fondamentales du judo : respect, courage, maîtrise de soi et entraide. Chaque séance est une occasion de grandir, sur le tatami et au quotidien.
          </p>

          <p class="text-gray-600 text-lg leading-relaxed mb-8">
            Depuis {club.foundedYear}, le club accueille enfants, adolescents et adultes dans une ambiance conviviale et familiale. Du loisir à la compétition, chacun trouve sa place et progresse à son rythme, encadré par des entraîneurs diplômés passionnés.
          </p>

          <a
            href={url("#contact")}
            class="inline-flex items-center gap-2 text-jcov font-semibold text-sm uppercase tracking-wider hover:text-jcov-dark transition-colors group"
          >
            Rejoindre le club
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>

        <div class="about__collage fade-in-up fade-in-up--delay-1">
          <div class="about__collage-main image-frame">
            <Image
              src={images.photodegroupe}
              alt="Les judokas du JCOV réunis sur le tatami du Dojo Marc Alexandre"
              width={900}
              height={675}
              fit="cover"
              position="bottom"
              class="w-full h-full object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/35 via-transparent to-transparent pointer-events-none" aria-hidden="true"></div>
            <span class="about__collage-tag">Le club à l'entraînement</span>
          </div>
          <div class="about__collage-secondary image-frame">
            <Image
              src={images.judophoto}
              alt="Projection de judo en pleine action"
              width={480}
              height={480}
              class="w-full h-full object-cover object-center"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider from="var(--surface)" to="var(--surface-deep)" />

  {/* Bandeau bleu : la seule section sombre de la page avant le footer.
      C'est la respiration au milieu des fonds clairs, et c'est ce qui fait
      ressortir l'appel à l'action le plus important de l'accueil. */}
  <section id="classes" class="band-blue py-20">
    <div class="band-blue__glow" aria-hidden="true"></div>
    <div class="grain-overlay" aria-hidden="true"></div>

    <div class="band-blue__content max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="section-eyebrow section-eyebrow--on-dark justify-center mb-3 fade-in-up">Planning</span>
      <h2 class="band-blue__title section-title font-bold mt-4 mb-4 fade-in-up">
        Un cours pour chaque âge, de 4 ans à adulte
      </h2>
      <p class="band-blue__lead text-lg mb-10 max-w-2xl mx-auto fade-in-up fade-in-up--delay-1">
        Indiquez l'âge du futur judoka et trouvez en quelques secondes ses jours de cours et sa cotisation.
      </p>
      <a href={url("/horaires")} class="classes-teaser__cta fade-in-up fade-in-up--delay-2">
        Voir les horaires &amp; tarifs
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14m-6-6 6 6-6 6" />
        </svg>
      </a>
    </div>
  </section>

  <!-- Actualités du club -->
  <SectionDivider from="var(--surface-deep)" to="var(--surface-soft)" flip />

  <section class="actualites-section">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 fade-in-up">
        <span class="section-eyebrow justify-center mb-3">Actualités du club</span>
        <h2 class="section-title font-bold text-gray-900 mt-4 mb-4">
          Les dernières performances du JCOV
        </h2>
        <p class="text-gray-600 text-lg max-w-2xl mx-auto">
          Découvrez les résultats, événements et réussites de nos judokas.
        </p>
      </div>

      <div class="actualites-grid">
        {actualites.map((entry, i) => (
          <article class={`actualites-card fade-in-up fade-in-up--delay-${i + 1}`}>
            <div class="actualites-card__image">
              <Image
                src={entry.data.image}
                alt={entry.data.imageAlt}
                width={640}
                height={480}
                class="actualites-card__photo"
              />
              <span class={`actualites-card__badge ${entry.data.badgeColor === 'gold' ? 'actualites-card__badge--gold' : ''}`}>{entry.data.badge}</span>
            </div>
            <div class="actualites-card__content">
              <p class="actualites-card__date">{dateFormatter.format(entry.data.date)}</p>
              <h3 class="actualites-card__title">{entry.data.title}</h3>
              <div class="actualites-card__text" set:html={entry.rendered?.html} />
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* Prochains événements — masqué s'il n'y en a aucun : mieux vaut une
      section absente qu'une section qui annonce le vide. Les séparateurs
      suivent, pour que l'enchaînement des fonds reste correct dans les
      deux cas. */}
  {prochainsEvenements.length > 0 && (
    <>
      <SectionDivider from="var(--surface-soft)" to="var(--surface-deep)" />

      {/* Second bandeau bleu : ici les cartes blanches des rendez-vous
          ressortent nettement mieux que sur le fond clair précédent. */}
      <section id="evenements" class="band-blue py-20">
        <div class="band-blue__glow band-blue__glow--right" aria-hidden="true"></div>
        <div class="grain-overlay" aria-hidden="true"></div>

        <div class="band-blue__content max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="text-center mb-12 fade-in-up">
            <span class="section-eyebrow section-eyebrow--on-dark justify-center mb-3">Agenda</span>
            <h2 class="band-blue__title section-title font-bold mt-4">
              Prochains rendez-vous
            </h2>
          </div>

          <div class="home-events" id="home-events">
            {prochainsEvenements.map((event, i) => (
              <div class={`fade-in-up fade-in-up--delay-${i + 1}`} hidden={i >= 2}>
                <EventCard event={event} headingLevel={3} />
              </div>
            ))}
          </div>

          {/* Toujours affiché : la page Événements donne aussi accès aux
              rendez-vous passés, même quand tout l'agenda tient ici. */}
          <div class="mt-10 text-center fade-in-up">
            <a href={url('/evenements')} class="home-events__more home-events__more--on-dark">
              Voir tous les événements
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14m-6-6 6 6-6 6" />
              </svg>
            </a>
          </div>
        </div>
      </section>

      <SectionDivider from="var(--surface-deep)" to="var(--brand-ice)" flip />
    </>
  )}

  {prochainsEvenements.length === 0 && <SectionDivider from="var(--surface-soft)" to="var(--brand-ice)" />}

  <section id="gallery" class="surface-ice py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 fade-in-up">
        <span class="section-eyebrow justify-center mb-3">Galerie</span>
        <h2 class="section-title font-bold text-gray-900 mt-4">Le club en images</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-6">
        {clubPhotos.map((photo, i) => (
          <div
            class={`card gallery-card-wrapper overflow-hidden rounded-xl transition-all duration-300 hover:shadow-lg hover:-translate-y-1 fade-in-up fade-in-up--delay-${i + 1}`}
            data-lightbox
            data-lightbox-src={fullSize.get(photo.key)}
            role="button"
            tabindex="0"
            aria-label={`Agrandir la photo : ${photo.alt}`}
          >
            <div class="image-frame aspect-[16/10]">
              <Image
                src={images[photo.key as keyof typeof images]}
                alt={photo.alt}
                width={900}
                height={563}
                class="gallery-card w-full h-full object-cover"
              />
            </div>
          </div>
        ))}
        <div class="gallery-more-note fade-in-up fade-in-up--delay-2">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <circle cx="8.5" cy="10" r="1.5" />
            <path d="M21 15l-5-5-9 9" />
          </svg>
          <p>D'autres photos du club et de nos judokas arrivent bientôt !</p>
        </div>
      </div>

      <div class="mt-10 text-center">
        <a
          href={url("/galerie")}
          class="inline-flex items-center gap-2 rounded-xl bg-jcov px-7 py-3.5 text-sm font-semibold uppercase tracking-wide text-white shadow-md shadow-jcov/25 transition hover:bg-jcov-dark hover:shadow-lg"
        >
          Voir toutes les photos
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14m-6-6 6 6-6 6" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <SectionDivider from="var(--brand-ice)" to="var(--surface-washi)" flip />

  <MoralCodeStrip />

  <section id="contact" class="py-20 contact-section">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="section-eyebrow justify-center mb-3 fade-in-up">Nous rejoindre</span>
      <h2 class="section-title font-bold text-gray-900 mb-6 mt-4 fade-in-up">
        Rejoignez-nous
      </h2>

      <p class="text-gray-600 text-lg mb-12 max-w-2xl mx-auto fade-in-up fade-in-up--delay-1">
        Venez découvrir le judo au sein du JCOV.<br>
        Une séance d'essai est possible tout au long de l'année.
      </p>

      <div class="contact-card fade-in-up fade-in-up--delay-2">
        {/* Grille à deux colonnes plutôt que trois lignes indépendantes : les
            trois valeurs partagent ainsi la même marge gauche. En centrant
            chaque ligne séparément, l'adresse sur quatre lignes et le
            téléphone sur une seule ne se calaient sur rien. */}
        <dl class="contact-details">
          <dt class="contact-details__icon" aria-hidden="true">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
          </dt>
          <dd class="contact-details__value">
            <span class="sr-only">Adresse : </span>
            {club.address.venue}<br>{club.address.building}<br>{club.address.street}<br>{club.address.city}
          </dd>

          <dt class="contact-details__icon" aria-hidden="true">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
          </dt>
          <dd class="contact-details__value">
            <span class="sr-only">Téléphone : </span>
            <a href={`tel:${club.phone.replace(/\s/g, '')}`} class="contact-details__link">{club.phone}</a>
          </dd>

          <dt class="contact-details__icon" aria-hidden="true">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
          </dt>
          <dd class="contact-details__value contact-details__value--email">
            <span class="sr-only">E-mail : </span>
            {/* Point de césure explicite avant l'arobase : sans lui, le
                navigateur coupe l'adresse au milieu d'un mot sur un petit
                écran (« …vigneux@outl / ook.com »). */}
            <a href={`mailto:${club.email}`} class="contact-details__link">{club.email.split('@')[0]}<wbr />@{club.email.split('@')[1]}</a>
          </dd>
        </dl>

        <a
          href={`mailto:${club.email}`}
          class="inline-block mt-8 bg-jcov text-white font-semibold px-8 py-3 rounded-xl hover:bg-jcov-dark transition-colors tracking-wide uppercase text-sm shadow-md shadow-jcov/25 hover:shadow-lg hover:shadow-jcov/30"
        >
          Nous contacter
        </a>
      </div>
    </div>
  </section>

  <Lightbox />
</MainLayout>

<script>
  // Même principe que sur la page Événements : le tri est figé à la
  // construction, le navigateur le corrige avec la date du jour. Quatre
  // rendez-vous sont présents dans la page, deux sont montrés.
  const container = document.getElementById('home-events');
  const section = document.getElementById('evenements');

  if (container && section) {
    const now = Date.now();
    let affiches = 0;

    for (const wrapper of [...container.children] as HTMLElement[]) {
      const card = wrapper.querySelector<HTMLElement>('[data-event-date]');
      const date = new Date(card?.dataset.eventDate ?? '').getTime();
      const aVenir = Number.isFinite(date) && date >= now;

      wrapper.hidden = !aVenir || affiches >= 2;
      if (!wrapper.hidden) affiches += 1;
    }

    // Plus aucun rendez-vous : la section entière disparaît, plutôt que
    // d'afficher un titre sans contenu.
    if (affiches === 0) {
      section.hidden = true;
      section.previousElementSibling?.setAttribute('hidden', '');
      section.nextElementSibling?.setAttribute('hidden', '');
    }
  }
</script>

<style>
  /* ── Bandeau photo ── */
  /* Bouton inversé : blanc plein sur le bandeau sombre. Le bleu du club,
     posé sur ce fond, se serait fondu dedans au lieu d'appeler le clic. */
  .classes-teaser__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 3.25rem;
    padding: 0 2rem;
    border-radius: 0.75rem;
    background: #ffffff;
    color: var(--brand-800, #063a5c);
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    box-shadow: 0 10px 30px rgba(2, 12, 24, 0.35);
    transition: transform 0.25s ease, box-shadow 0.25s ease, background-color 0.25s ease;
  }

  .classes-teaser__cta:hover {
    background: var(--brand-ice, #eaf7ff);
    transform: translateY(-2px);
    box-shadow: 0 16px 40px rgba(2, 12, 24, 0.42);
  }

  .home-events {
    display: grid;
    gap: 1.5rem;
  }

  .home-events__more {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0 1.5rem;
    border: 1.5px solid var(--brand-700);
    border-radius: 0.75rem;
    color: var(--brand-700);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.25s ease, color 0.25s ease, transform 0.25s ease;
  }

  /* Contour plutôt que bouton plein : le rendez-vous compte plus que ce lien,
     qui ne doit pas concurrencer les appels à l'action de la page. */
  .home-events__more:hover {
    background: var(--brand-700);
    color: #fff;
    transform: translateY(-2px);
  }

  /* Sur le bandeau bleu, un contour bleu serait invisible : le lien passe en
     blanc, et s'inverse au survol comme sur fond clair. */
  .home-events__more--on-dark {
    border-color: rgba(255, 255, 255, 0.5);
    color: #ffffff;
  }

  .home-events__more--on-dark:hover {
    background: #ffffff;
    border-color: #ffffff;
    color: var(--brand-800);
  }
</style>
