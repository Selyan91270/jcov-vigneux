---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';
import Hero from '../components/Hero.astro';
import Stats from '../components/Stats.astro';
import MoralCode from '../components/MoralCode.astro';
import FranceJudoNews from '../components/FranceJudoNews.astro';
import { club, clubPhotos, judoUniversePhotos } from '../data/club.ts';
import { images } from '../data/images.ts';

const actualites = (await getCollection('actualites')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const dateFormatter = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
---

<MainLayout title="JCOV - Judo Club Olympique de Vigneux">

  <Hero />

  <Stats />

  <section id="about" class="about-section relative pt-20 pb-20 sm:pt-24 md:pb-24 bg-white border-b border-gray-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div class="about__content fade-in-up">
          <span class="section-eyebrow mb-4">À propos</span>

          <h2 class="text-3xl md:text-4xl lg:text-[2.75rem] font-bold text-gray-900 mb-6 mt-4 tracking-tight leading-tight">
            Le Judo, une école de vie
          </h2>

          <p class="text-gray-600 text-lg leading-relaxed mb-6">
            Le Judo Club Olympique de Vigneux transmet les valeurs fondamentales du judo : respect, courage, maîtrise de soi et entraide. Chaque séance est une occasion de grandir, sur le tatami et au quotidien.
          </p>

          <p class="text-gray-600 text-lg leading-relaxed mb-8">
            Depuis {club.foundedYear}, le club accueille enfants, adolescents et adultes dans une ambiance conviviale et familiale. Du loisir à la compétition, chacun trouve sa place et progresse à son rythme, encadré par des entraîneurs diplômés passionnés.
          </p>

          <a
            href="#contact"
            class="inline-flex items-center gap-2 text-jcov font-semibold text-sm uppercase tracking-wider hover:text-jcov-dark transition-colors group"
          >
            Rejoindre le club
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>

        <div class="about__collage fade-in-up fade-in-up--delay-1">
          <div class="about__collage-main image-frame">
            <Image
              src={images.photodegroupe}
              alt="Les judokas du JCOV réunis sur le tatami du Dojo Marc Alexandre"
              width={900}
              height={675}
              fit="cover"
              position="bottom"
              class="w-full h-full object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/35 via-transparent to-transparent pointer-events-none" aria-hidden="true"></div>
            <span class="about__collage-tag">Le club à l'entraînement</span>
          </div>
          <div class="about__collage-secondary image-frame">
            <Image
              src={images.judophoto}
              alt="Projection de judo en pleine action"
              width={480}
              height={480}
              class="w-full h-full object-cover object-center"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="classes" class="classes-teaser py-20 bg-gray-50 border-b border-gray-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="section-eyebrow justify-center mb-3 fade-in-up">Planning</span>
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mt-4 mb-4 tracking-tight fade-in-up">
        Un cours pour chaque âge, de 4 ans à adulte
      </h2>
      <p class="text-gray-600 text-lg mb-10 max-w-2xl mx-auto fade-in-up fade-in-up--delay-1">
        Indiquez l'âge du futur judoka et trouvez en quelques secondes ses jours de cours et sa cotisation.
      </p>
      <a
        href="/horaires"
        class="inline-flex items-center gap-2 rounded-xl bg-jcov px-8 py-4 text-sm font-semibold uppercase tracking-wide text-white shadow-md shadow-jcov/25 transition hover:bg-jcov-dark hover:shadow-lg fade-in-up fade-in-up--delay-2"
      >
        Voir les horaires &amp; tarifs
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14m-6-6 6 6-6 6" />
        </svg>
      </a>
    </div>
  </section>

  <!-- Actualités du club -->
  <section class="actualites-section bg-white border-b border-gray-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 fade-in-up">
        <span class="section-eyebrow justify-center mb-3">Actualités du club</span>
        <h2 class="text-3xl md:text-4xl lg:text-[2.75rem] font-bold text-gray-900 mt-4 mb-4 tracking-tight leading-tight">
          Les dernières performances du JCOV
        </h2>
        <p class="text-gray-600 text-lg max-w-2xl mx-auto">
          Découvrez les résultats, événements et réussites de nos judokas.
        </p>
      </div>

      <div class="actualites-grid">
        {actualites.map((entry, i) => (
          <article class={`actualites-card fade-in-up fade-in-up--delay-${i + 1}`}>
            <div class="actualites-card__image">
              <Image
                src={entry.data.image}
                alt={entry.data.imageAlt}
                width={640}
                height={480}
                class="actualites-card__photo"
              />
              <span class={`actualites-card__badge ${entry.data.badgeColor === 'gold' ? 'badge-gold' : ''}`}>{entry.data.badge}</span>
            </div>
            <div class="actualites-card__content">
              <p class="actualites-card__date">{dateFormatter.format(entry.data.date)}</p>
              <h3 class="actualites-card__title">{entry.data.title}</h3>
              <div class="actualites-card__text" set:html={entry.rendered?.html} />
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="gallery" class="py-20 bg-gray-50 border-b border-gray-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 fade-in-up">
        <span class="section-eyebrow justify-center mb-3">Galerie</span>
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mt-4 tracking-tight">Le club en images</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-6">
        {clubPhotos.map((photo, i) => (
          <div class={`card gallery-card-wrapper overflow-hidden rounded-xl transition-all duration-300 hover:shadow-lg hover:-translate-y-1 fade-in-up fade-in-up--delay-${i + 1}`}>
            <div class="image-frame aspect-[16/10]">
              <Image
                src={images[photo.key as keyof typeof images]}
                alt={photo.alt}
                width={900}
                height={563}
                class="gallery-card w-full h-full object-cover"
              />
            </div>
          </div>
        ))}
        <div class="gallery-more-note fade-in-up fade-in-up--delay-2">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <circle cx="8.5" cy="10" r="1.5" />
            <path d="M21 15l-5-5-9 9" />
          </svg>
          <p>D'autres photos du club et de nos judokas arrivent bientôt !</p>
        </div>
      </div>

      <div class="gallery-universe">
        <p class="gallery-universe__label">L'univers du judo — photos d'illustration, compétitions internationales</p>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          {judoUniversePhotos.map((photo, i) => (
            <div class={`gallery-universe__item fade-in-up fade-in-up--delay-${i + 1}`}>
              <Image
                src={images[photo.key as keyof typeof images]}
                alt={photo.alt}
                width={400}
                height={400}
                class="w-full h-full object-cover"
              />
            </div>
          ))}
        </div>
      </div>

      <div class="mt-10 text-center">
        <a
          href="/galerie"
          class="inline-flex items-center gap-2 rounded-xl bg-jcov px-7 py-3.5 text-sm font-semibold uppercase tracking-wide text-white shadow-md shadow-jcov/25 transition hover:bg-jcov-dark hover:shadow-lg"
        >
          Voir toutes les photos
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14m-6-6 6 6-6 6" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <section id="contact" class="py-20 contact-section">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="section-eyebrow justify-center mb-3 fade-in-up">Nous rejoindre</span>
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6 mt-4 tracking-tight fade-in-up">
        Rejoignez-nous
      </h2>

      <p class="text-gray-600 text-lg mb-12 max-w-2xl mx-auto fade-in-up fade-in-up--delay-1">
        Venez découvrir le judo au sein du JCOV.<br>
        Une séance d'essai est possible tout au long de l'année.
      </p>

      <div class="contact-card fade-in-up fade-in-up--delay-2">
        <div class="space-y-4">
          <div class="flex items-center text-gray-700">
            <svg class="w-5 h-5 mr-3 text-jcov shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            {club.address.venue}<br>{club.address.street}<br>{club.address.city}
          </div>

          <div class="flex items-center text-gray-700">
            <svg class="w-5 h-5 mr-3 text-jcov shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
            {club.phone}
          </div>

          <div class="flex items-center text-gray-700">
            <svg class="w-5 h-5 mr-3 text-jcov shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
            {club.email}
          </div>
        </div>

        <a
          href={`mailto:${club.email}`}
          class="inline-block mt-8 bg-jcov text-white font-semibold px-8 py-3 rounded-xl hover:bg-jcov-dark transition-colors tracking-wide uppercase text-sm shadow-md shadow-jcov/25 hover:shadow-lg hover:shadow-jcov/30"
        >
          Nous contacter
        </a>
      </div>
    </div>
  </section>

  <MoralCode />

  <FranceJudoNews />

</MainLayout>
