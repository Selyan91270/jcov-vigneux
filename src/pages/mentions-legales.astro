---
import { url } from '../lib/url.ts';
import MainLayout from '../layouts/MainLayout.astro';
import { club, legal } from '../data/club.ts';
---

<MainLayout
  title="Mentions légales | JCOV Vigneux-sur-Seine"
  description="Mentions légales du site du Judo Club Olympique de Vigneux : éditeur, hébergeur et conditions d'utilisation."
>
  <section class="legal-page py-16 sm:py-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <a href={url("/")} class="legal-page__back">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m15 18-6-6 6-6" />
        </svg>
        Retour à l'accueil
      </a>

      <span class="section-eyebrow mb-3">JCOV</span>
      <h1 class="legal-page__title">Mentions légales</h1>

      <div class="legal-page__content">
        <h2>Éditeur du site</h2>
        <p>
          {club.name} ({club.shortName})<br>
          {legal.form}<br>
          Siège social : {legal.headOffice}<br>
          Téléphone : {club.phone}<br>
          E-mail : {club.email}
        </p>

        <h2>Immatriculation</h2>
        <dl class="legal-page__facts">
          <div><dt>N° RNA</dt><dd>{legal.rna}</dd></div>
          <div><dt>SIREN</dt><dd>{legal.siren}</dd></div>
          <div><dt>SIRET du siège</dt><dd>{legal.siret}</dd></div>
          <div><dt>Code APE / NAF</dt><dd>{legal.ape} — {legal.apeLabel}</dd></div>
        </dl>

        <h2>Directeur de la publication</h2>
        <p>{legal.publicationDirector}</p>

        <h2>Hébergement</h2>
        <p>
          Ce site est hébergé par {legal.host.name}, {legal.host.address}.<br>
          <a href={legal.host.url} target="_blank" rel="noopener noreferrer">{legal.host.url}</a>
        </p>

        <h2>Propriété intellectuelle</h2>
        <p>
          L'ensemble des contenus présents sur ce site (textes, photographies, logo, mise en page) est la
          propriété du {club.shortName}, sauf mention contraire. Les logos de la Ville de Vigneux-sur-Seine, du Département de
          l'Essonne, du Comité de l'Essonne de Judo et de la Fédération Française de Judo restent la propriété de
          leurs détenteurs respectifs et sont affichés au titre du partenariat et de l'affiliation du club.
        </p>

        <h2>Inscriptions</h2>
        <p>
          Les inscriptions se font sur formulaire papier, remis au dojo. Le site se limite à
          proposer ce formulaire au téléchargement et n'assure aucune inscription en ligne.
        </p>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .legal-page__back {
    display: flex;
    width: fit-content;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    color: var(--brand-700);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-decoration: none;
  }

  .legal-page__back svg {
    width: 1rem;
    height: 1rem;
  }

  .legal-page__back:hover {
    color: var(--brand-accent);
  }

  .legal-page__title {
    margin: 1rem 0 2rem;
    font-family: var(--ff-head);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    color: #0f172a;
  }

  .legal-page__content h2 {
    margin-top: 2rem;
    margin-bottom: 0.6rem;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--brand-700);
  }

  .legal-page__content p {
    color: #475569;
    line-height: 1.8;
  }

  .legal-page__content a {
    color: var(--brand-700);
    text-decoration: underline;
  }

  .legal-page__content em {
    color: #94a3b8;
  }

  /* Les numéros d'immatriculation se consultent, ils ne se lisent pas :
     en liste d'étiquettes plutôt qu'en phrase, on retrouve le SIRET d'un
     coup d'œil. */
  .legal-page__facts {
    margin: 0;
    display: grid;
    gap: 0.5rem 1.5rem;
  }

  .legal-page__facts > div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid rgba(3, 29, 56, 0.07);
  }

  .legal-page__facts dt {
    flex: 0 0 10rem;
    color: #0f172a;
    font-weight: 600;
  }

  .legal-page__facts dd {
    margin: 0;
    color: #475569;
    /* Un numéro d'immatriculation se relève chiffre par chiffre. */
    font-variant-numeric: tabular-nums;
  }
</style>
