---
import { url } from '../lib/url.ts';
import { Image, getImage } from 'astro:assets';
import MainLayout from '../layouts/MainLayout.astro';
import Lightbox from '../components/Lightbox.astro';
import { clubPhotos } from '../data/club.ts';
import { images } from '../data/images.ts';

// Versions haute définition servies uniquement à la visionneuse plein écran.
const fullSize = new Map(
  await Promise.all(
    clubPhotos.map(async (photo) => {
      const large = await getImage({
        src: images[photo.key as keyof typeof images],
        width: 1600,
        quality: 82,
      });
      return [photo.key, large.src] as const;
    })
  )
);
---

<MainLayout
  title="Galerie photos | JCOV Vigneux-sur-Seine"
  description="Les moments forts de la vie du Judo Club Olympique de Vigneux en photos : entraînements, groupes et événements du club."
>
  {/* La Galerie était la seule page intérieure bâtie autrement : une section
      unique sur fond blanc, sans en-tête, et son titre passait directement à
      celui du pied de page — aucun titre de section entre les deux. Elle suit
      maintenant la même structure que Professeurs, Horaires et Événements. */}
  <section class="page-header bg-white">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <a href={url("/")} class="back-link mb-6 inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-jcov hover:text-jcov-dark">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m15 18-6-6 6-6" />
        </svg>
        Retour à l'accueil
      </a>
      <span class="section-eyebrow mb-3">JCOV</span>
      <h1 class="text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl mt-4">Toutes les photos</h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-gray-600">
        Retrouvez les moments forts de la vie du club et de nos judokas.
      </p>
    </div>
  </section>

  <section class="py-16 sm:py-20 bg-gray-50 border-t border-gray-100">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <h2 class="gallery-page__heading fade-in-up">Entraînements et rencontres</h2>

      {/* Le nombre de colonnes suit le nombre de photos : à trois colonnes
          fixes, deux photos laissaient une case vide — c'est elle que le
          panneau « d'autres photos arrivent bientôt » venait combler. */}
      <div class={`grid grid-cols-1 gap-6 ${clubPhotos.length >= 3 ? 'sm:grid-cols-2 lg:grid-cols-3' : 'sm:grid-cols-2'}`}>
        {clubPhotos.map((photo, i) => (
          <figure
            class={`gallery-page__item fade-in-up fade-in-up--delay-${(i % 3) + 1}`}
            data-lightbox
            data-lightbox-src={fullSize.get(photo.key)}
            role="button"
            tabindex="0"
            aria-label={`Agrandir la photo : ${photo.alt}`}
          >
            <div class="aspect-[4/3]">
              <Image
                src={images[photo.key as keyof typeof images]}
                alt={photo.alt}
                width={700}
                height={525}
                class="h-full w-full object-cover"
              />
            </div>
            <figcaption class="px-4 py-3 text-sm font-medium text-gray-700">{photo.alt}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <Lightbox />
</MainLayout>

<style>
  .gallery-page__heading {
    font-family: var(--ff-head);
    font-size: clamp(1.5rem, 2.6vw, 1.9rem);
    font-weight: 700;
    color: #0f172a;
    letter-spacing: -0.01em;
    margin-bottom: 2rem;
  }

  /* Même rayon et même ombre que les autres cartes de contenu du site : la
     grille utilisait `rounded-xl` (12 px), réservé désormais aux boutons. */
  .gallery-page__item {
    overflow: hidden;
    background: #fff;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    cursor: zoom-in;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
  }

  .gallery-page__item:hover,
  .gallery-page__item:focus-visible {
    transform: translateY(-5px);
    box-shadow: var(--shadow-md);
  }

  .gallery-page__item img {
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .gallery-page__item:hover img {
    transform: scale(1.05);
  }
</style>

