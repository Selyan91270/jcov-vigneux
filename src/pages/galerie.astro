---
import { Image, getImage } from 'astro:assets';
import MainLayout from '../layouts/MainLayout.astro';
import Lightbox from '../components/Lightbox.astro';
import { clubPhotos } from '../data/club.ts';
import { images } from '../data/images.ts';

// Versions haute définition servies uniquement à la visionneuse plein écran.
const fullSize = new Map(
  await Promise.all(
    clubPhotos.map(async (photo) => {
      const large = await getImage({
        src: images[photo.key as keyof typeof images],
        width: 1600,
        quality: 82,
      });
      return [photo.key, large.src] as const;
    })
  )
);
---

<MainLayout
  title="Galerie photos - JCOV"
  description="Les moments forts de la vie du Judo Club Olympique de Vigneux en photos : entraînements, groupes et événements du club."
>
  <section class="gallery-page py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="mb-12 max-w-2xl">
        <a href="/" class="mb-6 inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-jcov hover:text-jcov-dark">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m15 18-6-6 6-6" />
          </svg>
          Retour à l'accueil
        </a>
        <span class="section-eyebrow mb-3">JCOV</span>
        <h1 class="text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl mt-4">Toutes les photos</h1>
        <p class="mt-4 text-lg leading-relaxed text-gray-600">
          Retrouvez les moments forts de la vie du club et de nos judokas.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 mb-8">
        {clubPhotos.map((photo) => (
          <figure
            class="gallery-page__item overflow-hidden rounded-xl bg-white shadow-sm"
            data-lightbox
            data-lightbox-src={fullSize.get(photo.key)}
            role="button"
            tabindex="0"
            aria-label={`Agrandir la photo : ${photo.alt}`}
          >
            <div class="aspect-[4/3]">
              <Image
                src={images[photo.key as keyof typeof images]}
                alt={photo.alt}
                width={700}
                height={525}
                class="h-full w-full object-cover"
              />
            </div>
            <figcaption class="px-4 py-3 text-sm font-medium text-gray-700">{photo.alt}</figcaption>
          </figure>
        ))}
        <div class="gallery-more-note">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <circle cx="8.5" cy="10" r="1.5" />
            <path d="M21 15l-5-5-9 9" />
          </svg>
          <p>D'autres photos du club et de nos judokas arrivent bientôt !</p>
        </div>
      </div>
    </div>
  </section>

  <Lightbox />
</MainLayout>

<style>
  .gallery-page__item {
    cursor: zoom-in;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
  }

  .gallery-page__item:hover,
  .gallery-page__item:focus-visible {
    transform: translateY(-5px);
    box-shadow: var(--shadow-md);
  }

  .gallery-page__item img {
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .gallery-page__item:hover img {
    transform: scale(1.05);
  }
</style>

