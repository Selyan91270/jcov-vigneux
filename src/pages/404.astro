---
import { url } from '../lib/url.ts';
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout
  title="Page introuvable | JCOV Vigneux-sur-Seine"
  description="Cette page n'existe pas ou a été déplacée. Retrouvez les horaires, les événements et les contacts du Judo Club Olympique de Vigneux."
>
  <section class="not-found">
    <div class="not-found__inner">
      <p class="not-found__kanji" aria-hidden="true">道</p>
      <p class="section-eyebrow justify-center mb-3">Erreur 404</p>
      <h1 class="not-found__title">Ippon manqué !</h1>
      <p class="not-found__text">
        La page que vous cherchez n'existe pas ou a été déplacée.
      </p>
      <a href={url("/")} class="hero__btn hero__btn--primary not-found__cta">Retour à l'accueil</a>
    </div>
  </section>
</MainLayout>

<style>
  .not-found {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4rem 1.5rem;
    background: linear-gradient(180deg, var(--brand-ice) 0%, #ffffff 100%);
  }

  .not-found__inner {
    position: relative;
    text-align: center;
    max-width: 32rem;
  }

  .not-found__kanji {
    position: absolute;
    top: -3.5rem;
    left: 50%;
    transform: translateX(-50%);
    font-size: 8rem;
    line-height: 1;
    color: rgba(11, 114, 173, 0.08);
    z-index: 0;
    pointer-events: none;
  }

  .not-found__title {
    position: relative;
    font-family: var(--ff-head);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    color: #0f172a;
    margin: 0.5rem 0 1rem;
  }

  .not-found__text {
    position: relative;
    color: #64748b;
    font-size: 1.05rem;
    margin-bottom: 2rem;
  }

  .not-found__cta {
    position: relative;
    color: #fff;
    text-decoration: none;
  }
</style>
