---
import { getCollection } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';

const now = new Date();
const allEvents = await getCollection('evenements');

const upcoming = allEvents
  .filter((e) => e.data.date >= now)
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

const past = allEvents
  .filter((e) => e.data.date < now)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const dayFormatter = new Intl.DateTimeFormat('fr-FR', { day: '2-digit' });
const monthFormatter = new Intl.DateTimeFormat('fr-FR', { month: 'short' });
const fullDateFormatter = new Intl.DateTimeFormat('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
---

<MainLayout title="Événements - JCOV">
  <section class="page-header py-16 sm:py-20 bg-white">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <a href="/" class="mb-6 inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-jcov hover:text-jcov-dark">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m15 18-6-6 6-6" />
        </svg>
        Retour à l'accueil
      </a>
      <span class="section-eyebrow mb-3">Vie du club</span>
      <h1 class="text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl mt-4">Événements</h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-gray-600">
        Forums, reprise des cours, stages, compétitions — tout ce qui rythme la saison du JCOV.
      </p>
    </div>
  </section>

  <section class="py-16 sm:py-20 bg-gray-50 border-t border-gray-100">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      {upcoming.length === 0 && (
        <p class="events-empty fade-in-up">Aucun événement à venir pour le moment — revenez bientôt !</p>
      )}

      <div class="events-list">
        {upcoming.map((event, i) => (
          <article class={`event-card fade-in-up fade-in-up--delay-${(i % 3) + 1}`}>
            <div class="event-card__date">
              <span class="event-card__day">{dayFormatter.format(event.data.date)}</span>
              <span class="event-card__month">{monthFormatter.format(event.data.date).replace('.', '')}</span>
            </div>
            <div class="event-card__body">
              <span class="event-card__category">{event.data.category}</span>
              <h2 class="event-card__title">{event.data.title}</h2>
              <p class="event-card__meta">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 21s-7-6.1-7-11a7 7 0 0 1 14 0c0 4.9-7 11-7 11Z" />
                  <circle cx="12" cy="10" r="2.5" />
                </svg>
                {event.data.location}
              </p>
              <p class="event-card__meta event-card__meta--date">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="5" width="18" height="16" rx="2" />
                  <path d="M8 3v4M16 3v4M3 10h18" />
                </svg>
                {fullDateFormatter.format(event.data.date)}{event.data.time ? ` · ${event.data.time}` : ''}
              </p>
              <p class="event-card__summary">{event.data.summary}</p>
            </div>
          </article>
        ))}
      </div>

      {past.length > 0 && (
        <div class="events-past">
          <h2 class="events-past__title">Événements passés</h2>
          <ul class="events-past__list">
            {past.map((event) => (
              <li>
                <span>{fullDateFormatter.format(event.data.date)}</span>
                {event.data.title}
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>
</MainLayout>

<style>
  .events-empty {
    text-align: center;
    color: #64748b;
    font-size: 1.05rem;
    padding: 2rem 0;
  }

  .events-list {
    display: grid;
    gap: 1.5rem;
  }

  .event-card {
    display: flex;
    gap: 1.5rem;
    background: #fff;
    border: 1px solid rgba(3, 29, 56, 0.08);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    padding: 1.75rem;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .event-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .event-card__date {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 5rem;
    height: 5rem;
    border-radius: 1rem;
    background: linear-gradient(150deg, var(--brand-900), var(--brand-700));
    color: #fff;
  }

  .event-card__day {
    font-family: var(--ff-head);
    font-size: 1.9rem;
    font-weight: 700;
    line-height: 1;
  }

  .event-card__month {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--brand-sky);
    margin-top: 0.25rem;
  }

  .event-card__body {
    min-width: 0;
    flex: 1;
  }

  .event-card__category {
    display: inline-block;
    background: var(--brand-ice);
    color: var(--brand-700);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    margin-bottom: 0.6rem;
  }

  .event-card__title {
    font-family: var(--ff-head);
    font-size: 1.4rem;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 0.65rem;
  }

  .event-card__meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #475569;
    font-size: 0.92rem;
    margin-bottom: 0.4rem;
  }

  .event-card__meta svg {
    width: 1.05rem;
    height: 1.05rem;
    color: var(--brand-accent);
    flex-shrink: 0;
  }

  .event-card__meta--date {
    text-transform: capitalize;
  }

  .event-card__summary {
    margin-top: 0.9rem;
    color: #334155;
    line-height: 1.6;
  }

  .events-past {
    margin-top: 3.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid rgba(3, 29, 56, 0.1);
  }

  .events-past__title {
    font-family: var(--ff-head);
    font-size: 1.15rem;
    font-weight: 700;
    color: #64748b;
    margin-bottom: 1.25rem;
  }

  .events-past__list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }

  .events-past__list li {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    color: #64748b;
    font-size: 0.92rem;
  }

  .events-past__list li span {
    font-weight: 600;
    color: #94a3b8;
    text-transform: capitalize;
  }
</style>
