---
import { url } from '../lib/url.ts';
import { getCollection } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';
import EventCard from '../components/EventCard.astro';
import { estAVenir } from '../lib/events.ts';

const allEvents = await getCollection('evenements');

const upcoming = allEvents
  .filter((e) => estAVenir(e.data.date))
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

const past = allEvents
  .filter((e) => !estAVenir(e.data.date))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fullDateFormatter = new Intl.DateTimeFormat('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
---

<MainLayout
  title="Événements du club | JCOV Vigneux-sur-Seine"
  description="Forums, reprise des cours, stages et compétitions : tous les rendez-vous de la saison du Judo Club Olympique de Vigneux."
>
  <section class="page-header bg-white">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <a href={url("/")} class="back-link mb-6 inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-jcov hover:text-jcov-dark">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m15 18-6-6 6-6" />
        </svg>
        Retour à l'accueil
      </a>
      <span class="section-eyebrow mb-3">Vie du club</span>
      <h1 class="text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl mt-4">Événements</h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-gray-600">
        Forums, reprise des cours, stages, compétitions — tout ce qui rythme la saison du JCOV.
      </p>
    </div>
  </section>

  <section class="py-16 sm:py-20 bg-gray-50 border-t border-gray-100">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      {/* « Aucun événement à venir » était une phrase grise seule au milieu
          d'une page vide. Or « Événements » est l'un des sept onglets du
          menu : quand l'agenda est creux — ce qui est le cas la plupart de
          l'année — un visiteur clique et tombe sur rien. L'encadré dit la
          même chose, mais renvoie vers ce qui existe. */}
      <div class="events-empty fade-in-up" id="events-empty" hidden={upcoming.length > 0}>
        <svg class="events-empty__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="5" width="18" height="16" rx="2.5" />
          <path d="M3 10h18M8 3v4M16 3v4" />
        </svg>
        <h2 class="events-empty__title">Rien d'annoncé pour l'instant</h2>
        <p class="events-empty__text">
          Le prochain rendez-vous n'est pas encore fixé. Les cours, eux, ont lieu toute la
          semaine, et les résultats du club sont publiés au fil de la saison.
        </p>
        <div class="events-empty__links">
          <a href={url('/horaires')} class="events-empty__btn">Voir les horaires</a>
          <a href={url('/#actualites')} class="events-empty__btn events-empty__btn--ghost">Les actualités du club</a>
        </div>
      </div>

      <div class="events-list" id="events-upcoming">
        {upcoming.map((event, i) => (
          <div class={`fade-in-up fade-in-up--delay-${(i % 3) + 1}`}>
            <EventCard event={event} />
          </div>
        ))}
      </div>

      <div class="events-past" id="events-past" hidden={past.length === 0}>
        <h2 class="events-past__title">Événements passés</h2>
        <ul class="events-past__list" id="events-past-list">
          {past.map((event) => (
            <li>
              <span>{fullDateFormatter.format(event.data.date)}</span>
              {event.data.title}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</MainLayout>

<script>
  // Le tri « à venir / passé » est figé à la construction du site. Le
  // navigateur, lui, connaît la date du jour : il rebascule ici les
  // événements dont la date vient d'être dépassée, sans attendre une
  // republication.
  import { estAVenir } from '../lib/events.ts';

  const upcoming = document.getElementById('events-upcoming');
  const pastSection = document.getElementById('events-past');
  const pastList = document.getElementById('events-past-list');
  const empty = document.getElementById('events-empty');

  if (upcoming && pastSection && pastList && empty) {
    const now = Date.now();

    for (const card of [...upcoming.querySelectorAll<HTMLElement>('[data-event-date]')]) {
      if (estAVenir(card.dataset.eventDate ?? '', now)) continue;

      const item = document.createElement('li');
      const date = document.createElement('span');
      date.textContent = card.dataset.eventLabel ?? '';
      item.append(date, card.dataset.eventTitle ?? '');
      // Les plus récents d'abord, comme le tri du rendu initial.
      pastList.prepend(item);

      // La carte est enveloppée dans le conteneur d'animation.
      (card.parentElement ?? card).remove();
    }

    pastSection.hidden = pastList.children.length === 0;
    empty.hidden = upcoming.children.length > 0;
  }
</script>

<style>
  .events-empty {
    background: #fff;
    border: 1px solid rgba(3, 29, 56, 0.08);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    padding: 3rem 2rem;
    text-align: center;
  }

  .events-empty__icon {
    width: 2.75rem;
    height: 2.75rem;
    margin: 0 auto 1.25rem;
    color: var(--brand-accent);
  }

  .events-empty__title {
    font-family: var(--ff-head);
    font-size: 1.45rem;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 0.6rem;
  }

  .events-empty__text {
    max-width: 34rem;
    margin: 0 auto;
    color: #64748b;
    line-height: 1.7;
  }

  .events-empty__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .events-empty__btn {
    display: inline-flex;
    align-items: center;
    min-height: var(--btn-height);
    padding: 0 1.5rem;
    border-radius: var(--radius-sm);
    background: linear-gradient(90deg, var(--brand-700), var(--brand-accent));
    color: #fff;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .events-empty__btn:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .events-empty__btn--ghost {
    background: none;
    border: 1px solid rgba(3, 29, 56, 0.16);
    color: var(--brand-700);
    box-shadow: none;
  }

  .events-empty__btn--ghost:hover {
    border-color: var(--brand-accent);
    background: var(--brand-ice);
    box-shadow: none;
  }

  .events-list {
    display: grid;
    gap: 1.5rem;
  }
</style>
