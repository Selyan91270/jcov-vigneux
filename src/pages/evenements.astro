---
import { url } from '../lib/url.ts';
import { getCollection } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';
import EventCard from '../components/EventCard.astro';

const now = new Date();
const allEvents = await getCollection('evenements');

const upcoming = allEvents
  .filter((e) => e.data.date >= now)
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

const past = allEvents
  .filter((e) => e.data.date < now)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fullDateFormatter = new Intl.DateTimeFormat('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
---

<MainLayout
  title="Événements - JCOV"
  description="Forums, reprise des cours, stages et compétitions : tous les rendez-vous de la saison du Judo Club Olympique de Vigneux."
>
  <section class="page-header py-16 sm:py-20 bg-white">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <a href={url("/")} class="back-link mb-6 inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-jcov hover:text-jcov-dark">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m15 18-6-6 6-6" />
        </svg>
        Retour à l'accueil
      </a>
      <span class="section-eyebrow mb-3">Vie du club</span>
      <h1 class="text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl mt-4">Événements</h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-gray-600">
        Forums, reprise des cours, stages, compétitions — tout ce qui rythme la saison du JCOV.
      </p>
    </div>
  </section>

  <section class="py-16 sm:py-20 bg-gray-50 border-t border-gray-100">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      {upcoming.length === 0 && (
        <p class="events-empty fade-in-up">Aucun événement à venir pour le moment — revenez bientôt !</p>
      )}

      <div class="events-list">
        {upcoming.map((event, i) => (
          <div class={`fade-in-up fade-in-up--delay-${(i % 3) + 1}`}>
            <EventCard event={event} />
          </div>
        ))}
      </div>

      {past.length > 0 && (
        <div class="events-past">
          <h2 class="events-past__title">Événements passés</h2>
          <ul class="events-past__list">
            {past.map((event) => (
              <li>
                <span>{fullDateFormatter.format(event.data.date)}</span>
                {event.data.title}
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>
</MainLayout>

<style>
  .events-empty {
    text-align: center;
    color: #64748b;
    font-size: 1.05rem;
    padding: 2rem 0;
  }

  .events-list {
    display: grid;
    gap: 1.5rem;
  }

  .events-past {
    margin-top: 3.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid rgba(3, 29, 56, 0.1);
  }

  .events-past__title {
    font-family: var(--ff-head);
    font-size: 1.15rem;
    font-weight: 700;
    color: #64748b;
    margin-bottom: 1.25rem;
  }

  .events-past__list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }

  .events-past__list li {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    color: #64748b;
    font-size: 0.92rem;
  }

  .events-past__list li span {
    font-weight: 600;
    color: #94a3b8;
    text-transform: capitalize;
  }
</style>
