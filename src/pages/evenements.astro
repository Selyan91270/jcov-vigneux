---
import { url } from '../lib/url.ts';
import { getCollection } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';
import EventCard from '../components/EventCard.astro';

const now = new Date();
const allEvents = await getCollection('evenements');

const upcoming = allEvents
  .filter((e) => e.data.date >= now)
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

const past = allEvents
  .filter((e) => e.data.date < now)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fullDateFormatter = new Intl.DateTimeFormat('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
---

<MainLayout
  title="Événements du club | JCOV Vigneux-sur-Seine"
  description="Forums, reprise des cours, stages et compétitions : tous les rendez-vous de la saison du Judo Club Olympique de Vigneux."
>
  <section class="page-header py-16 sm:py-20 bg-white">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <a href={url("/")} class="back-link mb-6 inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-jcov hover:text-jcov-dark">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m15 18-6-6 6-6" />
        </svg>
        Retour à l'accueil
      </a>
      <span class="section-eyebrow mb-3">Vie du club</span>
      <h1 class="text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl mt-4">Événements</h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-gray-600">
        Forums, reprise des cours, stages, compétitions — tout ce qui rythme la saison du JCOV.
      </p>
    </div>
  </section>

  <section class="py-16 sm:py-20 bg-gray-50 border-t border-gray-100">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <p class="events-empty fade-in-up" id="events-empty" hidden={upcoming.length > 0}>
        Aucun événement à venir pour le moment — revenez bientôt !
      </p>

      <div class="events-list" id="events-upcoming">
        {upcoming.map((event, i) => (
          <div class={`fade-in-up fade-in-up--delay-${(i % 3) + 1}`}>
            <EventCard event={event} />
          </div>
        ))}
      </div>

      <div class="events-past" id="events-past" hidden={past.length === 0}>
        <h2 class="events-past__title">Événements passés</h2>
        <ul class="events-past__list" id="events-past-list">
          {past.map((event) => (
            <li>
              <span>{fullDateFormatter.format(event.data.date)}</span>
              {event.data.title}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</MainLayout>

<script>
  // Le tri « à venir / passé » est figé à la construction du site. Le
  // navigateur, lui, connaît la date du jour : il rebascule ici les
  // événements dont la date vient d'être dépassée, sans attendre une
  // republication.
  const upcoming = document.getElementById('events-upcoming');
  const pastSection = document.getElementById('events-past');
  const pastList = document.getElementById('events-past-list');
  const empty = document.getElementById('events-empty');

  if (upcoming && pastSection && pastList && empty) {
    const now = Date.now();

    for (const card of [...upcoming.querySelectorAll<HTMLElement>('[data-event-date]')]) {
      if (new Date(card.dataset.eventDate ?? '').getTime() >= now) continue;

      const item = document.createElement('li');
      const date = document.createElement('span');
      date.textContent = card.dataset.eventLabel ?? '';
      item.append(date, card.dataset.eventTitle ?? '');
      // Les plus récents d'abord, comme le tri du rendu initial.
      pastList.prepend(item);

      // La carte est enveloppée dans le conteneur d'animation.
      (card.parentElement ?? card).remove();
    }

    pastSection.hidden = pastList.children.length === 0;
    empty.hidden = upcoming.children.length > 0;
  }
</script>

<style>
  .events-empty {
    text-align: center;
    color: #64748b;
    font-size: 1.05rem;
    padding: 2rem 0;
  }

  .events-list {
    display: grid;
    gap: 1.5rem;
  }
</style>
